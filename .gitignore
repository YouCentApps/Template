## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options
.vs/
.vscode/
# Uncomment if you have tasks you want to version control
# .vscode/tasks.json

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/
*.sln.iml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Nuget
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Azure Functions
local.settings.json

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# MAUI
# Generated
[Pp]latforms/[Aa]ndroid/[Rr]esources/[Vv]alues/
[Pp]latforms/[Ii]OS/[Rr]esources/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Rider
.idea/

# Azurite local storage
azurite-data/
__blobstorage__/
__queuestorage__/
__azurite_db_*.json

# Secrets - NEVER commit these!
**/appsettings.Production.json
**/appsettings.Staging.json
**/secrets.json
*.pfx
*.p12

# Environment files with sensitive data
.env
.env.local
.env.production

# Database files
*.db
*.db-shm
*.db-wal

# Logs
*.log
logs/

# Azure publish settings
*.PublishSettings
*.pubxml
*.pubxml.user

# NuGet
*.nuget.props
*.nuget.targets

# BeatPulse healthcheck temp database
healthchecksdb

# Backup files
*.bak
*~

# Node (if using npm for any frontend tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.AppleDouble
.LSOverride

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin
$RECYCLE.BIN/

# VS Code directories
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local History for Visual Studio Code
.history/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# JetBrains Rider
*.sln.iml

# Build Folders (temp)
[Oo]bj/
[Bb]in/

# MSIX Bundles
*.msix
*.appx
*.appxbundle

# APK/AAB files (large)
*.apk
*.aab

# iOS
*.ipa

# Published apps
publish/
Published/

# Temporary files
*.tmp
*.temp
*.cache

# Package files
*.zip
*.tar
*.gz

# Certificate files - keep secure!
*.cer
*.crt
*.key

## Prevent committing development appsettings files with sensitive data
**/appsettings.Development.json
