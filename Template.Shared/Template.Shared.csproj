<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- CA1716: "Shared" conflicts with VB keyword - renaming the namespace is a breaking change -->
    <!-- CA1308: ToLowerInvariant is intentional for email/username normalization -->
    <!-- CA1062: Null validation covered by Nullable=enable context in calling code -->
    <!-- CA1056/CA1054: URI-typed parameters/properties - string is intentional for cross-platform config -->
    <!-- CA1724: Policy name conflicts with System.Security.Policy - not an issue in C# context -->
    <!-- CA1003: Action/Func events are idiomatic in Blazor component patterns -->
    <!-- CA2234: Relative URL strings are required when HttpClient has a configured BaseAddress -->
    <!-- CA1031: Broad exception catches are intentional in HTTP client and JS interop wrappers -->
    <NoWarn>$(NoWarn);CA1716;CA1308;CA1062;CA1056;CA1724;CA1003;CA1054;CA2234;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
  </ItemGroup>

</Project>
