<Router AppAssembly="typeof(Template.Shared.Layout.MainLayout).Assembly" NotFoundPage="typeof(Template.Shared.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Template.Shared.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
