@page "/admin"
@using Template.Common.Services.Api
@using Template.Common.Services.State
@inject ITemplateApiClient ApiClient
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Admin</PageTitle>

<div class="settings-container">
    @if (!AuthState.IsAuthenticated)
    {
        <div class="auth-container">
            <div class="auth-card">
                <h2>Access Denied</h2>
                <p class="text-center">You need to be signed in to access admin panel.</p>
                <a href="/signin" class="btn btn-primary w-100">Sign In</a>
            </div>
        </div>
    }
    else if (!isAdmin)
    {
        <div class="auth-container">
            <div class="auth-card">
                <h2>Access Denied</h2>
                <p class="text-center">You don't have admin privileges.</p>
                <a href="/" class="btn btn-primary w-100">Go Home</a>
            </div>
        </div>
    }
    else
    {
        <div class="settings-header">
            <h1>Admin Panel</h1>
            <p>Manage admins and users</p>
        </div>

        @if (!string.IsNullOrEmpty(globalMessage))
        {
            <div class="alert alert-success">@globalMessage</div>
        }
        @if (!string.IsNullOrEmpty(globalError))
        {
            <div class="alert alert-danger">@globalError</div>
        }

        <!-- Tab Navigation -->
        <div class="auth-tabs" style="margin-bottom: 1.5rem;">
            <button class="@(activeTab == "users" ? "active" : "")" @onclick='() => activeTab = "users"'>Users</button>
            @if (canManageAdmins)
            {
                <button class="@(activeTab == "admins" ? "active" : "")" @onclick='() => activeTab = "admins"'>Admins</button>
            }
        </div>

        @if (activeTab == "users")
        {
            <div class="detail-card">
                <h3>User Management</h3>

                <!-- Search -->
                <div class="auth-form" style="margin-bottom: 1.5rem;">
                    <div class="form-group" style="flex-direction: row; gap: 0.5rem;">
                        <input type="text" class="form-control" @bind="userSearchQuery" placeholder="Search by username or email..." @onkeydown="HandleSearchKeyDown" />
                        <button class="btn btn-primary btn-sm" @onclick="SearchUsers" disabled="@isSearching">Search</button>
                        @if (userSearchQuery.Length > 0)
                        {
                            <button class="btn btn-outline btn-sm" @onclick="LoadAllUsers">Clear</button>
                        }
                    </div>
                </div>

                @if (isLoadingUsers)
                {
                    <div class="loading-spinner">Loading users...</div>
                }
                else if (users != null && users.Count > 0)
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--border-color);">
                                    <th style="padding: 0.75rem; text-align: left;">Username</th>
                                    <th style="padding: 0.75rem; text-align: left;">Email</th>
                                    <th style="padding: 0.75rem; text-align: center;">Active</th>
                                    <th style="padding: 0.75rem; text-align: left;">Created</th>
                                    <th style="padding: 0.75rem; text-align: center;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in users)
                                {
                                    <tr style="border-bottom: 1px solid var(--border-color);">
                                        <td style="padding: 0.75rem;">@user.Username</td>
                                        <td style="padding: 0.75rem;">@user.Email</td>
                                        <td style="padding: 0.75rem; text-align: center;">
                                            <span class="badge @(user.IsActive ? "badge-success" : "badge-warning")">@(user.IsActive ? "Yes" : "No")</span>
                                        </td>
                                        <td style="padding: 0.75rem;">@user.CreatedDate.ToString("MMM d, yyyy")</td>
                                        <td style="padding: 0.75rem; text-align: center;">
                                            @if (editingUserId == user.UserId)
                                            {
                                                <button class="btn btn-primary btn-sm" @onclick="SaveUserEdit">Save</button>
                                                <button class="btn btn-outline btn-sm" @onclick="CancelUserEdit">Cancel</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline btn-sm" @onclick="() => StartEditUser(user)">Edit</button>
                                                <button class="btn btn-danger btn-sm" @onclick="() => ToggleUserActive(user)">@(user.IsActive ? "Disable" : "Enable")</button>
                                            }
                                        </td>
                                    </tr>
                                    @if (editingUserId == user.UserId)
                                    {
                                        <tr style="background: var(--bg-light);">
                                            <td colspan="5" style="padding: 1rem;">
                                                <div class="auth-form" style="max-width: 400px;">
                                                    <div class="form-group">
                                                        <label>Username</label>
                                                        <input type="text" class="form-control" @bind="editUsername" />
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Email</label>
                                                        <input type="email" class="form-control" @bind="editEmail" />
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No users found.</p>
                }
            </div>
        }

        @if (activeTab == "admins" && canManageAdmins)
        {
            <div class="detail-card">
                <h3>Admin Management</h3>

                @if (isLoadingAdmins)
                {
                    <div class="loading-spinner">Loading admins...</div>
                }
                else if (admins != null)
                {
                    @if (admins.Count > 0)
                    {
                        <div style="overflow-x: auto; margin-bottom: 1.5rem;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr style="border-bottom: 2px solid var(--border-color);">
                                        <th style="padding: 0.75rem; text-align: left;">User ID</th>
                                        <th style="padding: 0.75rem; text-align: center;">Active</th>
                                        <th style="padding: 0.75rem; text-align: center;">Can Manage</th>
                                        <th style="padding: 0.75rem; text-align: left;">Created</th>
                                        <th style="padding: 0.75rem; text-align: center;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var admin in admins)
                                    {
                                        <tr style="border-bottom: 1px solid var(--border-color);">
                                            <td style="padding: 0.75rem; font-family: monospace; font-size: 0.85rem;">@admin.UserId[..8]...</td>
                                            <td style="padding: 0.75rem; text-align: center;">
                                                <span class="badge @(admin.IsActive ? "badge-success" : "badge-warning")">@(admin.IsActive ? "Yes" : "No")</span>
                                            </td>
                                            <td style="padding: 0.75rem; text-align: center;">
                                                <span class="badge @(admin.CanManageAdmins ? "badge-info" : "badge-warning")">@(admin.CanManageAdmins ? "Yes" : "No")</span>
                                            </td>
                                            <td style="padding: 0.75rem;">@admin.CreatedDate.ToString("MMM d, yyyy")</td>
                                            <td style="padding: 0.75rem; text-align: center;">
                                                <button class="btn btn-outline btn-sm" @onclick="() => ToggleAdminStatus(admin)">@(admin.IsActive ? "Disable" : "Enable")</button>
                                                <button class="btn btn-danger btn-sm" @onclick="() => RemoveAdmin(admin.UserId)">Remove</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Add new admin -->
                    <h4 style="margin-top: 1.5rem;">Add Admin</h4>
                    <div class="auth-form" style="max-width: 500px;">
                        <div class="form-group">
                            <label>Search user to promote</label>
                            <input type="text" class="form-control" @bind="adminSearchQuery" placeholder="Search by username or email..." />
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="SearchForAdminCandidate" disabled="@isSearchingAdmin">Search</button>

                        @if (adminCandidates != null && adminCandidates.Count > 0)
                        {
                            <div style="margin-top: 1rem;">
                                @foreach (var candidate in adminCandidates)
                                {
                                    <div class="detail-row">
                                        <span>@candidate.Username (@candidate.Email)</span>
                                        <button class="btn btn-primary btn-sm" @onclick="() => PromoteToAdmin(candidate.UserId)">Make Admin</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private bool isAdmin = false;
    private bool canManageAdmins = false;
    private string activeTab = "users";

    // Users
    private List<UserInfo>? users;
    private bool isLoadingUsers = true;
    private string userSearchQuery = "";
    private bool isSearching = false;
    private string? editingUserId;
    private string editUsername = "";
    private string editEmail = "";

    // Admins
    private List<AdminInfo>? admins;
    private bool isLoadingAdmins = true;
    private string adminSearchQuery = "";
    private bool isSearchingAdmin = false;
    private List<UserInfo>? adminCandidates;

    // Messages
    private string? globalMessage;
    private string? globalError;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
            return;

        var statusResponse = await ApiClient.GetMyAdminStatusAsync();
        if (statusResponse.Success && statusResponse.Data != null)
        {
            isAdmin = statusResponse.Data.IsAdmin;
            canManageAdmins = statusResponse.Data.CanManageAdmins;
        }

        if (isAdmin)
        {
            await LoadAllUsers();
            if (canManageAdmins)
                await LoadAdmins();
        }
    }

    private async Task LoadAllUsers()
    {
        isLoadingUsers = true;
        userSearchQuery = "";
        var response = await ApiClient.GetAllUsersAsync();
        if (response.Success && response.Data != null)
            users = response.Data;
        isLoadingUsers = false;
    }

    private async Task SearchUsers()
    {
        if (string.IsNullOrWhiteSpace(userSearchQuery) || userSearchQuery.Length < 2)
        {
            globalError = "Search query must be at least 2 characters.";
            return;
        }

        isSearching = true;
        globalError = null;
        var response = await ApiClient.SearchUsersAsync(userSearchQuery);
        if (response.Success && response.Data != null)
            users = response.Data;
        else
            globalError = response.Error ?? "Search failed.";
        isSearching = false;
    }

    private async Task HandleSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchUsers();
    }

    private async Task LoadAdmins()
    {
        isLoadingAdmins = true;
        var response = await ApiClient.GetAllAdminsAsync();
        if (response.Success && response.Data != null)
            admins = response.Data;
        isLoadingAdmins = false;
    }

    private void StartEditUser(UserInfo user)
    {
        editingUserId = user.UserId;
        editUsername = user.Username;
        editEmail = user.Email;
    }

    private void CancelUserEdit()
    {
        editingUserId = null;
    }

    private async Task SaveUserEdit()
    {
        if (editingUserId == null) return;
        globalMessage = null;
        globalError = null;

        var user = users?.FirstOrDefault(u => u.UserId == editingUserId);
        if (user == null) return;

        var response = await ApiClient.AdminUpdateUserAsync(editingUserId, editUsername, editEmail, user.IsActive);
        if (response.Success)
        {
            globalMessage = "User updated.";
            editingUserId = null;
            await LoadAllUsers();
        }
        else
        {
            globalError = response.Error ?? "Failed to update user.";
        }
    }

    private async Task ToggleUserActive(UserInfo user)
    {
        globalMessage = null;
        globalError = null;

        var response = await ApiClient.AdminUpdateUserAsync(user.UserId, user.Username, user.Email, !user.IsActive);
        if (response.Success)
        {
            globalMessage = $"User {(user.IsActive ? "disabled" : "enabled")}.";
            await LoadAllUsers();
        }
        else
        {
            globalError = response.Error ?? "Failed to update user.";
        }
    }

    private async Task ToggleAdminStatus(AdminInfo admin)
    {
        globalMessage = null;
        globalError = null;

        var response = await ApiClient.UpdateAdminAsync(admin.UserId, !admin.IsActive, admin.CanManageAdmins);
        if (response.Success)
        {
            globalMessage = $"Admin {(admin.IsActive ? "disabled" : "enabled")}.";
            await LoadAdmins();
        }
        else
        {
            globalError = response.Error ?? "Failed to update admin.";
        }
    }

    private async Task RemoveAdmin(string userId)
    {
        globalMessage = null;
        globalError = null;

        var response = await ApiClient.RemoveAdminAsync(userId);
        if (response.Success)
        {
            globalMessage = "Admin removed.";
            await LoadAdmins();
        }
        else
        {
            globalError = response.Error ?? "Failed to remove admin.";
        }
    }

    private async Task SearchForAdminCandidate()
    {
        if (string.IsNullOrWhiteSpace(adminSearchQuery) || adminSearchQuery.Length < 2)
        {
            globalError = "Search query must be at least 2 characters.";
            return;
        }

        isSearchingAdmin = true;
        globalError = null;
        var response = await ApiClient.SearchUsersAsync(adminSearchQuery);
        if (response.Success && response.Data != null)
        {
            // Filter out existing admins
            var adminUserIds = admins?.Select(a => a.UserId).ToHashSet() ?? new HashSet<string>();
            adminCandidates = response.Data.Where(u => !adminUserIds.Contains(u.UserId)).ToList();
            if (adminCandidates.Count == 0)
                globalMessage = "No non-admin users found matching your search.";
        }
        else
        {
            globalError = response.Error ?? "Search failed.";
        }
        isSearchingAdmin = false;
    }

    private async Task PromoteToAdmin(string userId)
    {
        globalMessage = null;
        globalError = null;

        var response = await ApiClient.CreateAdminAsync(userId, true, false);
        if (response.Success)
        {
            globalMessage = "User promoted to admin.";
            adminCandidates = null;
            adminSearchQuery = "";
            await LoadAdmins();
        }
        else
        {
            globalError = response.Error ?? "Failed to create admin.";
        }
    }
}
