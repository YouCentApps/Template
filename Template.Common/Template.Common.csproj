<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- CA1724: Policy name conflicts with System.Security.Policy - not an issue in C# context -->
    <!-- CA1003: Action/Func events are idiomatic in Blazor component patterns -->
    <!-- CA2234: Relative URL strings are required when HttpClient has a configured BaseAddress -->
    <NoWarn>$(NoWarn);CA1724;CA1003;CA1054;CA2234</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

</Project>
